{
  "name": "sahara-grill",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "seed:menu": "tsx scripts/seed-menu.ts",
    "seed:menu:force": "tsx scripts/seed-menu.ts --force",
    "seed:menu:cli": "sanity exec scripts/seed-menu-cli.ts --with-user-token",
    "seed:menu:cli:force": "sanity exec scripts/seed-menu-cli.ts --with-user-token -- --force",
    "images:optimize": "node scripts/optimize-site-images.mjs",
    "sanity:setup": "node scripts/setup-sanity-project.mjs",
    "sanity:check-webhook": "node scripts/check-menu-webhook.mjs",
    "sanity:inspect": "sanity exec scripts/inspect-menu-cms.ts --with-user-token",
    "sanity:prepare-production": "sanity exec scripts/configure-menu-webhook.ts --with-user-token -- --apply",
    "sanity:enable-webhook": "sanity exec scripts/configure-menu-webhook.ts --with-user-token -- --apply --enable",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "@radix-ui/react-accordion": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-navigation-menu": "^1.1.4",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-tabs": "^1.0.4",
    "@sanity/image-url": "^2.1.1",
    "@sanity/vision": "^3.99.0",
    "@vercel/analytics": "^1.3.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "framer-motion": "^11.2.6",
    "lucide-react": "^0.378.0",
    "mongodb": "^6.7.0",
    "next": "14.2.3",
    "next-sanity": "^9.12.3",
    "next-themes": "^0.3.0",
    "react": "^18",
    "react-dom": "^18",
    "sanity": "^3.99.0",
    "sharp": "^0.35.5",
    "styled-components": "^6.5.1",
    "tailwind-merge": "^2.3.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "dotenv": "^17.4.2",
    "eslint": "^8",
    "eslint-config-next": "14.2.3",
    "postcss": "^8",
    "prisma": "^5.14.0",
