MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority"

# Public Sanity connection (safe for the browser / Studio)
NEXT_PUBLIC_SANITY_PROJECT_ID=""
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2024-01-01"

# Server-only secrets — never use NEXT_PUBLIC_ for these, never commit real values
# Editor/Admin token for seeding scripts only
SANITY_API_WRITE_TOKEN=""
# Shared secret for the /api/revalidate webhook (Publish → website refresh)
SANITY_REVALIDATE_SECRET=""
